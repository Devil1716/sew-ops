# ==========================================
# SewOps Monorepo Environment Variables
# ==========================================

# --- Frontend Web (apps/web) ---
# In development: http://localhost:4000/v1
# In production on Vercel: /v1 (relative, proxied via Next.js rewrites on same origin)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/v1

# Realtime Socket.IO gateway
# In development: http://localhost:4000
# In production on Vercel: leave empty to connect to the current origin (proxied to /socket.io)
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000

# Backend destination URL for Next.js rewrites (BUILD-TIME variable for apps/web on Vercel)
# e.g. https://sew-ops-api.vercel.app
INTERNAL_API_URL=

# Fixtures switch: MUST be false in production
NEXT_PUBLIC_USE_FIXTURES=false

# --- Backend API (apps/api) ---
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed frontend origins (must use https:// in production)
CORS_ORIGIN=http://localhost:3000

# PostgreSQL connection strings
# DATABASE_URL: Pooled connection string in serverless production (e.g. Supabase port 6543 / PgBouncer with ?sslmode=require)
DATABASE_URL=postgresql://sewops:change_me@localhost:5432/sewops?schema=public
# DIRECT_URL: Direct connection string for Prisma migrations (port 5432)
DIRECT_URL=postgresql://sewops:change_me@localhost:5432/sewops?schema=public

# Secrets (minimum 32 characters, 64+ hex chars recommended in production)
JWT_ACCESS_SECRET=change_me_to_a_long_random_string_of_64_plus_chars

# Proxy hops for rate limiting and secure cookies (1 on Vercel / reverse proxies)
TRUST_PROXY_HOPS=1


# Secrets (minimum 32 characters, 64+ hex chars recommended in production)
JWT_ACCESS_SECRET=change_me_to_a_long_random_string_of_64_plus_chars

# Proxy hops for rate limiting and secure cookies (1 on Vercel / reverse proxies)
TRUST_PROXY_HOPS=1