# Compose Postgres container settings (used by docker-compose.yml).
POSTGRES_USER=sewops
POSTGRES_PASSWORD=change_me
POSTGRES_DB=sewops

# These are examples for local app configuration; copy the workspace-specific
# templates to apps/api/.env and apps/web/.env.local as described in README.md.
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://sewops:change_me@localhost:5432/sewops?schema=public
DIRECT_URL=postgresql://sewops:change_me@localhost:5432/sewops?schema=public
JWT_ACCESS_SECRET=change_me_to_a_long_random_string_of_64_plus_chars
TRUST_PROXY_HOPS=1
REALTIME_REDIS_URL=redis://localhost:6380

NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/v1
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000
INTERNAL_API_URL=
NEXT_PUBLIC_USE_FIXTURES=false
