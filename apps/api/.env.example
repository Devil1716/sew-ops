# ==========================================
# SewOps API (apps/api) Environment Variables
# ==========================================

NODE_ENV=development
PORT=4000

# Comma-separated list of allowed frontend origins (must use https:// and exact origins in production)
CORS_ORIGIN=http://localhost:3000

# PostgreSQL connection strings
# DATABASE_URL: Pooled connection string in serverless production (e.g. Supabase port 6543 / Neon with ?sslmode=require)
DATABASE_URL=postgresql://sewops:change_me@localhost:5432/sewops?schema=public
# DIRECT_URL: Direct connection string for Prisma migrations (port 5432)
DIRECT_URL=postgresql://sewops:change_me@localhost:5432/sewops?schema=public

# Minimum 32 characters (64+ hex characters recommended in production)
JWT_ACCESS_SECRET=change_me_to_a_long_random_string_of_64_plus_chars

# Proxy hops: 1 or 'true' when deployed behind Vercel or reverse proxies to extract real visitor IP
TRUST_PROXY_HOPS=1
