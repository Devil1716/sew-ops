# Copy to .env.production.local for a local production-mode rehearsal.
# Replace the DB password and JWT secret with your local values.
NODE_ENV=production
DATABASE_URL=postgresql://sewops:replace-with-compose-password@127.0.0.1:5432/sewops?schema=public
DIRECT_URL=postgresql://sewops:replace-with-compose-password@127.0.0.1:5432/sewops?schema=public
JWT_ACCESS_SECRET=replace-with-a-random-64-character-hex-value
CORS_ORIGIN=https://localhost:3000
ALLOW_LOCALHOST_ORIGIN=true
REDIS_URL=redis://localhost:6380
TRUST_PROXY_HOPS=1
PORT=4000
