{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "nestjs",
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "cd ../.. && node apps/api/scripts/migrate-deploy-safe.cjs && npm run build:api",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}

