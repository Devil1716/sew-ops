# ==========================================
# SewOps Web (apps/web) Environment Variables
# ==========================================

# Backend API base URL
# Local dev: http://localhost:4000/v1
# Vercel production: /v1 (relative, routed via Next.js rewrites on same origin)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/v1

# Realtime Socket.IO gateway
# Local dev: http://localhost:4000
# Vercel production: leave empty so Socket.IO connects to window.location.origin (proxied to /socket.io)
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000

# Backend destination URL for Next.js rewrites (BUILD-TIME variable for Vercel Project 2)
# When set, Next.js rewrites /v1/:path*, /health, and /socket.io/:path* to this backend URL
# Example: https://sew-ops-api.vercel.app
INTERNAL_API_URL=

# Dev-only fixtures switch: MUST be false in production
NEXT_PUBLIC_USE_FIXTURES=false
